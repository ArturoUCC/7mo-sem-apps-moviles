        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.arturop.ViveBS"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-splash-screen",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "c634ab8e-dea4-41ae-a152-e37a5754186c"
      }
    }
  }
}
